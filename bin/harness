#!/usr/bin/env bash
# Run the harness in a rootless podman container. The model's tools (bash, read_file, write_file)
# act inside it, and only these host paths are visible:
#
#   markov binary          -> /usr/local/bin/markov          ro
#   the workflow files     -> /harness                        ro  (meta.yaml, vars*, rules.yaml,
#                                                                 step_types.yaml, workflows/, scripts/, skills/, agents/)
#   relay key              -> /run/secrets/relay-api-key      ro
#   .state/container/      -> /state   (sessions, memory, skills, agents, markov.log, markov-state.db)
#   $HARNESS_WORKDIR       -> /work    (the tools' cwd; default: the directory you run this from)
#
# Every mount gets :z so SELinux-enforcing hosts relabel it for container access.
#
# The repo root is the directory workflow, but only its workflow files are mounted: markov fingerprints
# the whole workflow directory to notice edits on resume, and .state/ (sessions, logs, the state db)
# changes on every run. tests/, demo/ and the rest stay out of the container too.
#
#   bin/harness [--var k=v ...]
#   HARNESS_WORKDIR=~/src/project bin/harness
#   HARNESS_PROJECT_ID=myproject bin/harness    # memory shared by every work dir with this ID
#   bin/harness --print-memory-dir             # where this work dir's memory lives on the host
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
markov="$(realpath "${MARKOV:-$here/../markov/bin/static/markov}")"   # CGO_ENABLED=0: make -C ../markov build-static
image="${HARNESS_IMAGE:-localhost/markov-harness:1}"
workdir="$(realpath "${HARNESS_WORKDIR:-$PWD}")"
state="$here/.state/container"
key="$here/.state/relay-api-key"
relay_host="relay-api.local"
# One memory dir per project, /state/projects/<key>/memory. The project is the work dir, keyed like
# Claude Code's (every non-alphanumeric -> '-') plus a hash of the full path, since the slug alone
# collides (/a/b-c and /a/b/c). HARNESS_PROJECT_ID names the project instead, so several work dirs
# (checkouts, worktrees, a moved dir) can share one memory; a path key starts with '-', so an ID can't
# collide with one.
if [ -n "${HARNESS_PROJECT_ID:-}" ]; then
    [[ "$HARNESS_PROJECT_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
        echo "harness: HARNESS_PROJECT_ID must be letters, digits, '.', '_' or '-', starting with a letter or digit" >&2
        exit 2
    }
    project_key="$HARNESS_PROJECT_ID"
else
    project_key="$(printf '%s' "$workdir" | sed 's/[^A-Za-z0-9]/-/g')-$(printf '%s' "$workdir" | sha256sum | cut -c1-8)"
fi
memory_dir="/state/projects/$project_key/memory"
if [ "${1:-}" = "--print-memory-dir" ]; then   # the host path, for tests and scripts
    echo "$state/projects/$project_key/memory"
    exit 0
fi

# :z relabels what it mounts; refuse directories where that (or exposing them to tools) is a bad idea.
case "$workdir" in
    / | "$HOME" | /home | /usr* | /etc* | /var | /root)
        echo "harness: refusing to mount $workdir as the tool work dir; set HARNESS_WORKDIR to a project dir" >&2
        exit 2 ;;
esac
[ -r "$key" ] || { echo "harness: missing relay key at $key" >&2; exit 2; }
relay_ip="$(getent ahostsv4 "$relay_host" | awk 'NR==1 {print $1}')"
[ -n "$relay_ip" ] || { echo "harness: cannot resolve $relay_host" >&2; exit 2; }
# With rootless pasta networking the container gets a copy of the host's address, so a relay running
# on this host is unreachable at that address from inside; podman's host-gateway reaches the host.
if ip -4 -o addr show | awk '{split($4, a, "/"); print a[1]}' | grep -qxF "$relay_ip"; then
    relay_ip=host-gateway
fi

if ! podman image exists "$image"; then
    echo "harness: building $image ..." >&2
    podman build -q -t "$image" -f "$here/container/Containerfile" "$here/container" >&2
fi

mkdir -p "$state/sessions" "$state/skills" "$state/agents"
workflow_mounts=()
for part in meta.yaml vars.yaml vars rules.yaml step_types.yaml workflows scripts skills agents; do
    if [ -e "$here/$part" ]; then
        workflow_mounts+=(-v "$here/$part:/harness/$part:ro,z")
    fi
done

tty_flags=(-i)
[ -t 0 ] && tty_flags=(-it)

exec podman run --rm "${tty_flags[@]}" \
    --userns=keep-id \
    --cap-drop=all --security-opt=no-new-privileges \
    --read-only --tmpfs /tmp:rw,size=256m \
    --memory=2g --pids-limit=512 \
    --add-host "$relay_host:$relay_ip" \
    -e HOME=/tmp \
    -v "$markov:/usr/local/bin/markov:ro,z" \
    "${workflow_mounts[@]}" \
    -v "$key:/run/secrets/relay-api-key:ro,z" \
    -v "$state:/state:rw,z" \
    -v "$workdir:/work:rw,z" \
    -w /work \
    "$image" \
    sh -c 'exec markov run /harness --state-store /state/markov-state.db \
             --callback "tty://?show=text,thinking:dim,output:lines,tool_input:count" --var state_dir=/state --var relay_key_file=/run/secrets/relay-api-key "$@" 2>>/state/markov.log' \
    harness --var "memory_dir=$memory_dir" --var skills_dir=/state/skills --var agents_dir=/state/agents "$@"
